[global]
ioengine=/home/xuanboj2/spdk-iaa/build/fio/spdk_nvme
thread=1
direct=1
group_reporting=1
time_based=1
runtime=30
ramp_time=3
iodepth=1

# This engine is synchronous, so bandwidth scaling comes from larger block sizes.
bs=128k
size=128m

[rdma-test]
rw=read
filename=trtype=RDMA adrfam=IPv4 traddr=192.168.200.20 trsvcid=4420 subnqn=nqn.2016-06.io.spdk\:cnode1 ns=1